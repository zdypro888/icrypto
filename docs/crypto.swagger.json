          "format": "byte"
        }
      },
      "title": "ADI 开始配置请求"
    },
    "icryptoADIStartProvisioningResponse": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "format": "uint64"
        },
        "CPIM": {
          "type": "string",
          "format": "byte"
        }
      },
      "title": "ADI 开始配置响应"
    },
