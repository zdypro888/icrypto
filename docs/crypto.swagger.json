  "definitions": {
    "icryptoADIEndProvisioningRequest": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "format": "uint64"
        },
        "DSID": {
          "type": "string",
          "format": "int64"
        },
        "RINFO": {
          "type": "string",
          "format": "int64"
        },
        "PTM": {
          "type": "string",
          "format": "byte"
        },
        "TK": {
          "type": "string",
          "format": "byte"
        },
        "ADI": {
          "type": "string",
          "format": "byte"
        }
      },
      "title": "ADI 结束配置请求"
    },
    "icryptoADIEndProvisioningResponse": {
      "type": "object",
      "properties": {
        "MID": {
          "type": "string",
          "format": "byte"
        },
        "OTP": {
          "type": "string",
          "format": "byte"
        },
        "ADI": {
          "type": "string",
          "format": "byte"
        }
      },
      "title": "ADI 结束配置响应"
    },
    "icryptoADIGenerateLoginCodeRequest": {
      "type": "object",
      "properties": {
        "DSID": {
          "type": "string",
          "format": "int64"
        },
        "ADI": {
          "type": "string",
          "format": "byte"
        }
      },
      "title": "ADI 生成登录码请求"
    },
    "icryptoADIGenerateLoginCodeResponse": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "loginCode": {
          "type": "integer",
          "format": "int64"
        }
      },
      "title": "ADI 生成登录码响应"
    },
    "icryptoADIStartProvisioningRequest": {
      "type": "object",
      "properties": {
        "DSID": {
          "type": "string",
          "format": "int64"
        },
        "SPIM": {
