      "type": "object",
      "properties": {
        "handshakeResponse": {
          "type": "string",
          "format": "byte"
        },
        "serverKey": {
          "type": "string",
          "format": "byte"
        }
      },
      "title": "额外Absinthe/PSC握手响应；handshake_response不是NAC输出的validation-data。"
    },
    "icryptoAbsintheActivateSessionResponse": {
      "type": "object",
      "title": "Absinthe 激活会话响应"
    },
    "icryptoAbsintheAddOptionRequest": {
      "type": "object",
      "properties": {
        "bikKey": {
          "type": "string",
          "format": "byte"
        },
        "baaCert": {
          "type": "string",
          "format": "byte"
        },
        "intermediateRootCert": {
          "type": "string",
          "format": "byte"
        }
      },
      "title": "配置额外Absinthe/PSC会话的BAA选项；BIK字节尚不支持导入，非空必须报错。"
    },
    "icryptoAbsintheAddOptionResponse": {
